# Copy to .env and replace every CHANGE_ME value. Never commit .env.

# --- CouchDB ---
COUCHDB_USER=admin
COUCHDB_PASSWORD=CHANGE_ME
COUCHDB_AUTO_INITIALIZE=true
COUCHDB_INIT_FAIL_FAST=false

# --- Kafka (KRaft). Generate once: docker run --rm apache/kafka:3.8.1 /opt/kafka/bin/kafka-storage.sh random-uuid
KAFKA_CLUSTER_ID=CHANGE_ME

# --- Backend ---
SPRING_PROFILES_ACTIVE=docker
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Security (synthetic role passwords; never commit real secrets) ---
APP_AUTH_SECRET=CHANGE_ME_32_CHAR_RANDOM_SECRET
APP_SECURITY_ADMIN_USER=admin
APP_SECURITY_ADMIN_PASSWORD=CHANGE_ME
APP_SECURITY_OPS_USER=operations
APP_SECURITY_OPS_PASSWORD=CHANGE_ME
APP_SECURITY_VIEWER_USER=viewer
APP_SECURITY_VIEWER_PASSWORD=CHANGE_ME

# --- Host ports ---
BACKEND_PORT=8080
FRONTEND_PORT=3000
COUCHDB_PORT=5984
KAFKA_EXTERNAL_PORT=9094
